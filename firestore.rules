rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Order validation helper
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'orderId', 'items', 'customerName', 'customerPhone', 'fulfilmentMethod', 'subtotal', 'deliveryFee', 'totalAmount', 'status', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.orderId is string && data.orderId.size() <= 128
        && data.customerName is string && data.customerName.size() <= 150
        && data.customerPhone is string && data.customerPhone.size() <= 50
        && data.fulfilmentMethod is string && data.fulfilmentMethod.size() <= 50
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.subtotal is number && data.subtotal >= 0
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status is string && data.status == 'confirmed'
        && data.createdAt == request.time;
    }

    // Orders Collection
    match /orders/{orderId} {
      // Single order read restricted to the customer who created it
      allow get: if isOwner(existing().userId);

      // Customer-specific list queries enforced by resource.data.userId == request.auth.uid
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Customer order creation strictly validated and tied to their own auth UID
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());

      // Orders are immutable from the client once submitted
      allow update, delete: if false;
    }

    // Booking validation helper
    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'serviceId', 'serviceName', 'bookingDate', 'bookingTime', 'totalAmount', 'status', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.serviceId is string && data.serviceId.size() <= 128
        && data.serviceName is string && data.serviceName.size() <= 150
        && data.bookingDate is string && data.bookingDate.size() <= 100
        && data.bookingTime is string && data.bookingTime.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status is string && data.status == 'confirmed'
        && data.createdAt == request.time;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      allow update, delete: if false;
    }
  }
}
